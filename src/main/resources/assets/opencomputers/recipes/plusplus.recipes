# OC++ stage1 defaults: vanilla/OC ingredients; every new craft yields one.
# Edit user.recipes to override. Never globally substitute old-tier materials.
# GPU/APU recipes reject configured or renamed component inputs to preserve data.

ocpp_chip4 {
  input: [["minecraft:obsidian","minecraft:obsidian","minecraft:obsidian"],["redstone","oc:materialTransistor","redstone"],["minecraft:obsidian","minecraft:obsidian","minecraft:obsidian"]]
  output: 1
}

ocpp_cpu4 {
  input: [["minecraft:obsidian","redstone","minecraft:obsidian"],["oc:ocpp_chip4","oc:materialCU","oc:ocpp_chip4"],["minecraft:obsidian","oc:materialALU","minecraft:obsidian"]]
  output: 1
}

ocpp_ram4 {
  input: [["oc:ocpp_chip4","minecraft:obsidian","oc:ocpp_chip4"],["","oc:materialCircuitBoardPrinted",""]]
  output: 1
}

ocpp_ram4_5 {
  input: [["oc:ocpp_chip4","oc:ocpp_chip5","oc:ocpp_chip4"],["","oc:materialCircuitBoardPrinted",""]]
  output: 1
}

ocpp_hdd4 {
  input: [["oc:ocpp_chip4","oc:materialDisk","minecraft:obsidian"],["oc:materialCircuitBoardPrinted","oc:materialDisk","craftingPiston"],["oc:ocpp_chip4","oc:materialDisk","minecraft:obsidian"]]
  output: 1
}

ocpp_gpu4 {
  type: ocpp_pristine_shaped
  input: [["oc:ocpp_chip4","oc:materialALU","oc:ocpp_ram4"],["","oc:materialCard",""]]
  output: 1
}

ocpp_apu4 {
  type: ocpp_pristine_shaped
  input: [["minecraft:obsidian","oc:ocpp_chip4","minecraft:obsidian"],["oc:ocpp_cpu4","oc:componentBus3","oc:ocpp_gpu4"],["minecraft:obsidian","oc:ocpp_chip4","minecraft:obsidian"]]
  output: 1
}

ocpp_case4 {
  input: [["minecraft:obsidian","oc:ocpp_chip4","minecraft:obsidian"],["fenceIron","chest","fenceIron"],["minecraft:obsidian","oc:materialCircuitBoardPrinted","minecraft:obsidian"]]
  output: 1
}

ocpp_screen4 {
  input: [["minecraft:obsidian","minecraft:glowstone","minecraft:obsidian"],["minecraft:glowstone","oc:ocpp_chip4","blockGlass"],["minecraft:obsidian","minecraft:glowstone","minecraft:obsidian"]]
  output: 1
}

